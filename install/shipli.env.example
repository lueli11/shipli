# Konfiguration einer Shipli-Installation. Der Installer (install/proxmox.sh) fragt die Werte ab und legt diese Datei
# auf der ersten Node unter /etc/shipli/shipli.env ab; update.sh und add-node.sh lesen sie dort.

# Adresse der Oberfläche; ein DNS-Eintrag A auf SHIPLI_PUBLIC_IP muss darauf zeigen
SHIPLI_HOST=shipli.example.com
# Öffentliche IPv4, auf der Port 80 und 443 ankommen (Portweiterleitung im Router auf SHIPLI_INGRESS_IP)
SHIPLI_PUBLIC_IP=203.0.113.7
# Basis der App-Adressen <projekt>--<user>.<domain>; ohne eigene Wildcard-Domain einfach <ip-mit-strichen>.sslip.io
SHIPLI_DOMAIN=203-0-113-7.sslip.io
# Eigene Domains, unter denen User keine Domain eintragen dürfen (mit Komma), z. B. die Hauptdomain von SHIPLI_HOST
SHIPLI_BLOCKED_DOMAINS=example.com
SHIPLI_IMAGE=ghcr.io/lueli11/shipli:latest

# Netz der VMs: 1 oder 3 Node-IPs (mit Leerzeichen), dazu zwei freie IPs im selben Netz
SHIPLI_NODES="10.0.80.11 10.0.80.12 10.0.80.13"
SHIPLI_GATEWAY=10.0.80.1
SHIPLI_API_VIP=10.0.80.10
SHIPLI_INGRESS_IP=10.0.80.20
# Nur hinter einem bestehenden Proxy (SNI-Passthrough): dessen IPs als YAML-Liste, in Hochkommas, z. B. '["10.0.5.41/32"]'
SHIPLI_TRUSTED_IPS=[]
